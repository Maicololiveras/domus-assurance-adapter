{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domus.assurance.request/v1",
  "type": "object",
  "required": ["schema_version", "request_id", "project_id", "candidate", "artifact_snapshot", "surfaces", "risk_policy", "authorization"],
  "properties": {
    "schema_version": { "const": "domus.assurance.request/v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "required": ["version", "source_revision", "environment"],
      "properties": {
        "version": { "type": "string" },
        "source_revision": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifact_snapshot": { "type": "object", "minProperties": 1 },
    "surfaces": { "type": "array", "minItems": 1 },
    "test_results": { "type": "array", "default": [] },
    "risk_policy": { "type": "object", "required": ["profile"] },
    "authorization": { "type": "object", "required": ["allowed_actions", "forbidden_actions"] }
  },
  "additionalProperties": false
}

